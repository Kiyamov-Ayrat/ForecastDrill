 /* users.css — интерфейс S-11 «Пользователи и роли» */
 .users-head{justify-content:space-between;margin-bottom:10px}
 .users-head h3{margin:0}
+/* users.css — интерфейс S-11 «Пользователи и роли» */
+.users-head{justify-content:space-between;margin-bottom:10px}
+.users-head h3{margin:0}
+.users-form{border-left:4px solid var(--acc)}
+.users-form .row label{min-width:180px;flex:1}
